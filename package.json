{
  "name": "squiggle",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --port 8788",
    "test": "vitest run",
    "test:watch": "vitest",
    "export:csv": "node scripts/export-csv.mjs > questions.csv && echo \"wrote questions.csv\"",
    "lint:questions": "vite-node scripts/lint-questions.mjs",
    "preview:phone": "vite preview --host",
    "dev:phone": "vite --host"
  },
  "dependencies": {
    "framer-motion": "^11.11.9",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "roughjs": "^4.6.6"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.3",
    "vite": "^5.4.10",
    "vitest": "^2.1.9"
  },
  "description": "A daily game about how badly we all estimate the world."
}